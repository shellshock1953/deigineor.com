{
  "name": "deigineor-app",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=4096\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "migrate": "pnpm payload migrate",
    "migrate:create": "pnpm payload migrate:create",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@openpanel/nextjs": "^1.5.2",
    "@payloadcms/db-postgres": "3.92.0",
    "@payloadcms/next": "3.92.0",
    "@payloadcms/richtext-lexical": "3.92.0",
    "@payloadcms/ui": "3.92.0",
    "@sentry/nextjs": "^11.9.0",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.9",
    "graphql": "^16.14.2",
    "next": "16.4.3",
    "payload": "3.92.0",
    "react": "~19.2.9",
    "react-dom": "~19.2.9",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.7.3"
  }
}
